{
  "name": "edityy",
  "version": "0.1.3",
  "description": "A visual editing layer for code-based websites. Drop the launcher into a dev server you already run.",
  "license": "MIT",
  "author": "Farhan Tawfeeq <webdesignbyft@gmail.com>",
  "homepage": "https://github.com/farhantawfeeq56/edityy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhantawfeeq56/edityy.git",
    "directory": "packages/edityy"
  },
  "bugs": {
    "url": "https://github.com/farhantawfeeq56/edityy/issues"
  },
  "keywords": [
    "visual-editor",
    "dev-server",
    "middleware",
    "localhost",
    "ai",
    "codebase",
    "vite-plugin",
    "mcp"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./inject": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "bin": {
    "edityy": "./src/cli.js"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./src/edityy.js",
    "./src/client.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
